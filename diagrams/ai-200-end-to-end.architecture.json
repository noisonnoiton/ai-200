  "cards": [
    {
      "dot": "cyan",
      "title": "Request lifecycle",
      "items": [
        "Keep synchronous API work short and enqueue long-running AI jobs.",
        "Use durable delivery and design consumers for retries and idempotency.",
        "Retrieve evidence before sending a grounded prompt to the model."
      ]
    },
    {
      "dot": "emerald",
      "title": "Data choices",
      "items": [
        "Cosmos DB: distributed operational JSON and vector search.",
        "PostgreSQL: relational data, SQL, metadata filters, and pgvector.",
        "Managed Redis: low-latency cache, semantic cache, or vector index."
      ]
    },
    {
      "dot": "rose",
      "title": "Production controls",
      "items": [
        "Images are versioned in ACR; secrets stay in Key Vault.",
        "App Configuration stores non-secret runtime settings.",
        "OpenTelemetry context connects API, messaging, worker, data, and model evidence."
      ]
    }
  ]
